{
  "name": "visto-console",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": "24.19.x", "pnpm": "11.25.0" },
  "scripts": {
    "dev": "vite --configLoader native",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters --allowUnreachableCode false --allowUnusedLabels false",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "build": "tsc --noEmit && vite build --configLoader native",
    "preview": "vite preview --configLoader native --host 127.0.0.1 --strictPort"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
